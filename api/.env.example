# Local development values only; copy to api/.env and keep that file out of Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=api_user
MYSQL_PASSWORD=local_api_password
MYSQL_DATABASE=pjme_energy
# MYSQL_SOURCE_ID=1  # Optional override; otherwise resolve the canonical source metadata.
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DATABASE=pjme_energy
MONGO_COLLECTION=energy_observations
